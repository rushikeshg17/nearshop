# Copy to .env and adjust. All settings are optional in local development.
NEARSHOP_ENVIRONMENT=development
# Required outside development. Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
NEARSHOP_SECRET_KEY=change-me
# NEARSHOP_DATABASE_URL=sqlite:///./nearshop.db
# City to seed (ballari, mysuru, hubballi, vijayawada, coimbatore, nashik)
NEARSHOP_SEED_CITY=ballari
# Password for the seeded demo accounts (priya@ / owner@ / admin@nearshop.demo)
NEARSHOP_DEMO_PASSWORD=nearshop123
# fastembed (all-MiniLM-L6-v2, downloaded once) or tfidf (fully offline fallback)
NEARSHOP_EMBEDDING_PROVIDER=fastembed
NEARSHOP_COOKIE_SECURE=false
